    {"key": "design-rules", "type": "cards", "title": "THE LOOK IN THREE RULES", "items": [
      {"title": "ONE ACCENT", "text": "Indigo is the accent of the product. One accent per surface."},
      {"title": "GREEN IS STATUS", "text": "Emerald means the current status. It is never decoration."},
      {"title": "DARK AND LIGHT", "text": "Every surface has both versions. Text values pass 4.5:1."}
    ]},
    {"key": "infra-flow", "type": "flow", "title": "THE DEMO STACK", "nodes": [
