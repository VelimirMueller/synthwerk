    {"key": "index-areas", "type": "cards", "title": "FOUR WAYS INTO THE DOCS", "items": [
      {"title": "PRODUCT", "text": "Use cases, feature catalogue, stakeholder guide, design system."},
      {"title": "BUILD", "text": "Getting started, developer guide, contribution guide, architecture."},
      {"title": "RUN", "text": "Infrastructure, hosting and database, CI/CD, third-party tools."},
      {"title": "PROJECT", "text": "Roadmap, ticket board, changelog, release notes, license."}
    ]},
    {"key": "start-terminal", "type": "terminal", "title": "GET THE MAP", "lines": [
      "$ gh repo clone VelimirMueller/synthwerk",
      "$ cd synthwerk",
      "$ python3 scripts/check-ascii.py",
      "# exit 0: all rules pass",
      "$ scripts/check-links.sh",
      "# exit 0: all links resolve"
    ]},
    {"key": "usecases-personas", "type": "cards", "title": "FOUR PEOPLE, FOUR GOALS", "items": [
      {"title": "SAM, SOLO DEV", "text": "Adds AI chat to a client site fast. Uses the snippet and the SDK."},
      {"title": "LENA, AGENCY", "text": "Runs one widget on many sites from one admin."},
      {"title": "MAX, END USER", "text": "Asks a question and gets a streamed answer. Scans a card."},
      {"title": "ADA, ADMIN", "text": "Sees health, manages users and tunes the AI."}
    ]},
